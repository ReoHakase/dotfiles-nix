{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    // Immutable action refs + tag comment — see helpers:pinGitHubActionDigests preset.
    // https://docs.renovatebot.com/modules/manager/github-actions/
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Asia/Tokyo",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  prConcurrentLimit: 4,
  prHourlyLimit: 4,
  automerge: true,
  automergeType: "pr",
  platformAutomerge: false,
  commitMessageLowerCase: "never",
  commitMessagePrefix: "build(deps): ⬆️",
  commitMessageAction: "update",

  // flake.lock は nix manager が rev / narHash を更新する。
  nix: { enabled: true },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am"],
    automerge: true,
    automergeType: "pr",
    platformAutomerge: false,
    commitMessageAction: "update",
    commitMessageTopic: "flake inputs",
    commitMessageExtra: null,
  },

  packageRules: [
    {
      description: "Pin actions/setup-node node-version inputs (uses-with deps).",
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      matchDepNames: ["node"],
      rangeStrategy: "pin",
    },
    {
      matchManagers: ["nix"],
      groupName: "flake inputs",
      commitMessageTopic: "flake inputs",
    },
  ],
}
